# ../perf_records/master/
if(NOT DEFINED SRC_DIR)
  set(SRC_DIR "${CTEST_SCRIPT_DIRECTORY")
endif()

set(CTEST_SOURCE_DIRECTORY "${SRC_DIR}")
set(CTEST_BINARY_DIRECTORY "${CTEST_SOURCE_DIRECTORY}/build-ctest2")

set(CTEST_SITE "local")
set(CTEST_BUILD_NAME "local-build")

set(CTEST_CMAKE_GENERATOR "Ninja")

ctest_start("Workflow Test")

ctest_configure(OPTIONS "-DCMAKE_C_COMPILER=clang;-DCMAKE_CXX_COMPILER=clang++")
#(# -C Release
#  SOURCE ${CTEST_SOURCE_DIRECTORY} BUILD ${CTEST_BINARY_DIRECTORY})

ctest_build(TARGET "example")

